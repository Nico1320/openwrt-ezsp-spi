+++ b/target/linux/ipq40xx/files-6.12/arch/arm/boot/dts/qcom/qcom-ipq4019-whw03.dts
@@ -132,3 +132,22 @@
 		nvmem-cell-names = "pre-calibration", "mac-address";
 	};
 };
+
+/*
+ * gpio29 is wired to the eMMC on this revision, not to the Zigbee NCP -- the
+ * vendor binary's pin table calls it "nCS", but the NCP's chip select is
+ * gpio45. Hold it so nothing can drive it as a chip select and take the rootfs
+ * with it.
+ *
+ * The V2 has NAND instead and does not need it held; leaving it free there is
+ * what lets the vendor NCP flasher drive it. Verified booting and meshing on a
+ * V2 with this hog absent.
+ */
+&tlmm {
+	zigbee-0 {
+		gpio-hog;
+		gpios = <29 GPIO_ACTIVE_HIGH>;
+		bias-disable;
+		output-low;
+	};
+};
