#!/bin/sh
# rpcd backend for luci-app-ezsp-spi.

. /usr/share/libubox/jshn.sh
. /lib/functions.sh

INIT=/etc/init.d/ezsp-spi
BIN=/usr/sbin/ezsp-spi

sock_path() {
	local sock
	config_load ezsp-spi
	config_get sock radio socket /var/run/ezsp-spi.sock
	echo "$sock"
}

emit_status() {
	local out running key val sock mode port bind report_secs enabled
	local sent failed

	config_load ezsp-spi
	config_get sock radio socket /var/run/ezsp-spi.sock
	config_get mode radio mode router
	config_get report_secs radio report_secs 300
	config_get_bool enabled radio enabled 1
	config_get port bridge port 8888
	config_get bind bridge bind 0.0.0.0

	out=$($BIN status --socket "$sock" 2>&1)

	if [ "$mode" = bridge ]; then
		pgrep -f 'ezsp-spi bridge' >/dev/null 2>&1 && running=1 || running=0
	else
		pgrep -f 'ezsp-spi run' >/dev/null 2>&1 && running=1 || running=0
	fi

	json_init
	json_add_boolean running "$running"
	json_add_boolean enabled "$enabled"
	json_add_string mode "$mode"
	json_add_int report_secs "$report_secs"
	json_add_int bridge_port "$port"
	json_add_string bridge_bind "$bind"

	for key in state eui64 node_id node_type pan_id ext_pan_id channel tx_power reports last_report; do
		val=$(echo "$out" | sed -n "s/^${key}: //p" | head -n1)
		[ -n "$val" ] && json_add_string "$key" "$val"
	done

	val=$(echo "$out" | sed -n 's/^reports: //p' | head -n1)
	sent=$(echo "$val" | sed -n 's/^\([0-9]*\) sent.*/\1/p')
	failed=$(echo "$val" | sed -n 's/.*, \([0-9]*\) failed.*/\1/p')
	json_add_int reports_sent "${sent:-0}"
	json_add_int reports_failed "${failed:-0}"

	# The bridge has no control socket, so its only observable state is the
	# listening port and whoever is connected to it.
	if [ "$mode" = bridge ]; then
		netstat -ltn 2>/dev/null | grep -q ":$port " \
			&& json_add_boolean listening 1 \
			|| json_add_boolean listening 0

		json_add_array clients
		while read -r peer; do
			[ -n "$peer" ] && json_add_string "" "$peer"
		done <<-EOF
		$(netstat -tn 2>/dev/null | awk -v p=":$port" \
			'$0 ~ p && /ESTABLISHED/ { print $5 }')
		EOF
		json_close_array
	fi

	json_add_string raw "$out"
	json_dump
}

emit_scan() {
	local out mode parsed ch pan ext joinable lqi rssi

	config_load ezsp-spi
	config_get mode radio mode router

	if [ "$mode" = bridge ]; then
		json_init
		json_add_boolean available 0
		json_add_array networks
		json_close_array
		json_dump
		return
	fi

	out=$($INIT scan 2>&1)

	parsed=$(echo "$out" | awk '
		/^  network on channel/ { ch = $4; have = 1; next }
		have && /^    pan id/        { pan = $3; next }
		have && /^    ext pan id/    { ext = $4; next }
		have && /^    allowing join/ { j = $3; next }
		have && /^    lqi \/ rssi/   {
			printf "%s|%s|%s|%s|%s|%s\n", ch, pan, ext, j, $4, $6
			have = 0; next }
	')

	json_init
	json_add_boolean available 1
	json_add_array networks
	while IFS='|' read -r ch pan ext joinable lqi rssi; do
		[ -n "$ch" ] || continue
		json_add_object
		json_add_int channel "$ch"
		json_add_string pan_id "$pan"
		json_add_string ext_pan_id "$ext"
		[ "$joinable" = YES ] && json_add_boolean joinable 1 \
				      || json_add_boolean joinable 0
		json_add_int lqi "${lqi:-0}"
		json_add_int rssi "${rssi:-0}"
		json_close_object
	done <<-EOF
	$parsed
	EOF
	json_close_array
	json_add_string raw "$out"
	json_dump
}

emit_neighbors() {
	local out sock line addr lqi incost outcost dest via state mode

	config_load ezsp-spi
	config_get mode radio mode router

	# In bridge mode the client owns the radio and the daemon keeps no
	# network state, so there is nothing to read.
	if [ "$mode" = bridge ]; then
		json_init
		json_add_boolean available 0
		json_add_string mode bridge
		json_add_array neighbors
		json_close_array
		json_add_array routes
		json_close_array
		json_dump
		return
	fi

	sock=$(sock_path)
	out=$($BIN neighbors --socket "$sock" 2>&1)

	json_init
	json_add_boolean available 1

	# Heredoc, not a pipe: a pipe runs the loop in a subshell and the
	# json_add_* calls are lost.
	json_add_array neighbors
	while read -r line; do
		case "$line" in
		neighbor:*)
			set -- $line
			addr=$2; lqi=$4; incost=$6; outcost=$8
			json_add_object
			json_add_string addr "$addr"
			json_add_int lqi "${lqi:-0}"
			json_add_int in_cost "${incost:-0}"
			json_add_int out_cost "${outcost:-0}"
			json_close_object
			;;
		esac
	done <<-EOF
	$out
	EOF
	json_close_array

	json_add_array routes
	while read -r line; do
		case "$line" in
		route:*)
			set -- $line
			dest=$3; via=$5; state=$7
			json_add_object
			json_add_string dest "$dest"
			json_add_string via "$via"
			json_add_int state "${state:-0}"
			json_close_object
			;;
		esac
	done <<-EOF
	$out
	EOF
	json_close_array

	json_add_string raw "$out"
	json_dump
}

case "$1" in
list)
	json_init
	json_add_object status
	json_close_object
	json_add_object neighbors
	json_close_object
	json_add_object scan
	json_close_object
	json_add_object join
	json_add_string channel ""
	json_add_string pan_id ""
	json_close_object
	json_add_object leave
	json_close_object
	json_dump
	;;
call)
	case "$2" in
	status)
		emit_status
		;;
	neighbors)
		emit_neighbors
		;;
	scan)
		emit_scan
		;;
	join)
		# Optional channel/pan_id: written to uci first, so the UI can join
		# a scanned network without the user editing the config.
		read -r input
		json_load "${input:-{\}}" 2>/dev/null
		json_get_var arg_ch channel
		json_get_var arg_pan pan_id

		if [ -n "$arg_ch" ] && [ -n "$arg_pan" ]; then
			uci set ezsp-spi.network.channel="$arg_ch"
			uci set ezsp-spi.network.pan_id="$arg_pan"
			uci commit ezsp-spi
		fi

		out=$($INIT join 2>&1)
		rc=$?
		json_init
		json_add_int code "$rc"
		json_add_string output "$out"
		json_dump
		;;
	leave)
		out=$($INIT leave 2>&1)
		rc=$?
		json_init
		json_add_int code "$rc"
		json_add_string output "$out"
		json_dump
		;;
	*)
		json_init
		json_add_string error "unknown method"
		json_dump
		;;
	esac
	;;
esac
