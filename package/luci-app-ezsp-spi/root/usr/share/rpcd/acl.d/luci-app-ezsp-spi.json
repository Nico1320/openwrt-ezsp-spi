{
    "luci-app-ezsp-spi": {
        "description": "Grant access to the EZSP-SPI Zigbee router",
        "read": {
            "ubus": {
                "ezsp": [
                    "status",
                    "neighbors",
                    "join_status"
                ]
            },
            "uci": [
                "ezsp-spi"
            ]
        },
        "write": {
            "ubus": {
                "ezsp": [
                    "join",
                    "leave",
                    "scan"
                ]
            },
            "uci": [
                "ezsp-spi"
            ]
        }
    }
}