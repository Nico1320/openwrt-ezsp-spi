# EZSP-SPI Zigbee router.
#
# The radio section is board specific: it describes how the NCP is wired.
# The network section is site specific: which Zigbee network to join.

config radio 'radio'
	option enabled '0'

	# 'router'  join someone else's Zigbee network and repeat for it.
	# 'bridge'  hand the radio to a host over TCP, which
	#           lets them use it as a coordinator. See the bridge section.
	# The two are mutually exclusive: only one process can hold the radio.
	option mode 'router'

	option spidev '/dev/spidev1.0'
	option gpiochip '/dev/gpiochip0'

	# Board GPIO line offsets, not the base-512 sysfs numbers.
	# These are for the Linksys WHW03 V2.
	#   V1 differs: wake is 55 and nSSEL_INT is 56. Both autodetected.
	option reset '49'
	option wake '31'
	option hostint '50'

	# nSSEL_INT. AN711 says it "must be tied to nSSEL" -- it is a second
	# NCP input carrying the same chip select, because the SPI peripheral's
	# own nSSEL cannot raise an interrupt while the part is asleep. Linksys
	# gave it its own host GPIO instead of strapping it to nSSEL on the
	# board, so the host has to drive both together.
	#
	# The line differs by revision and is autodetected from the board name:
	# gpio29 on the V2, gpio56 on the V1. Leave it unset. Never set 29 on a
	# V1 -- that pin is the eMMC's there, and the tool refuses to drive it.
	#
	# 'follow' drives it with nSSEL, which is what the part expects.
	# 'input' leaves it alone; that only appeared to work because we never
	# let the NCP sleep.
	option nssel_int_mode 'follow'

	option speed '1000000'
	option socket '/var/run/ezsp-spi.sock'

	# Seconds between Basic-cluster attribute reports. These are what give
	# the coordinator a frame to take a link quality reading from. 0 = off.
	# Drop it to 60 while measuring, then put it back.
	option report_secs '300'

	# LEDs to blink when a coordinator sends Identify. Comma separated
	# names from /sys/class/leds. Whatever they were doing is restored
	# afterwards. Empty leaves them alone -- the cluster still works,
	# there is just nothing to look at. Red and blue together read as
	# purple on the WHW03.
	option identify_led 'red:indicator,blue:indicator'

	# EZSP version to request first. 4 works everywhere and auto-negotiates,
	# but if the NCP runs a newer stack (5.10.2 reports v5, 6.7.8 reports
	# v8) setting it here avoids an extra reset on every command.
	option ezsp_version '4'

config network 'network'
	# Which network to join. "ezsp-spi scan" lists both. The extended pan
	# id is picked up during the join, so it is not needed here.
	option channel '25'
	option pan_id '4920'

# Only used when radio.mode is 'bridge'. The radio is served as an ASH
# endpoint over TCP, so a host-side stack can run it as a coordinator.
#
# There is no authentication on this port and whoever connects owns your
# Zigbee network. Keep it on the LAN, or firewall it to the host.
config bridge 'bridge'
	option port '8888'
	option bind '0.0.0.0'
